# ==========================================================================
# LifeLink AI — Environment configuration (placeholders only)
#
# NEVER commit real secrets. Copy this file to .env and fill in real values.
# ==========================================================================

# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --------------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------------
POSTGRES_USER=lifelink
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=lifelink
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --------------------------------------------------------------------------
# Auth / Security
# --------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Encryption keys used for vault data (KMS-driven in production)
VAULT_MASTER_KEY=change_me_vault_master_key
SECRET_ENCRYPTION_KEY=change_me_secret_encryption_key

# --------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# --------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=lifelink-documents
MINIO_SECURE=false

# --------------------------------------------------------------------------
# AI provider
# --------------------------------------------------------------------------
AI_PROVIDER=mock
GEMINI_API_KEY=change_me_gemini
GEMINI_MODEL=gemini-2.0-flash

# --------------------------------------------------------------------------
# Email / Notifications (console transport by default in dev)
# --------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lifelink@example.com
EMAIL_TRANSPORT=console

# --------------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
